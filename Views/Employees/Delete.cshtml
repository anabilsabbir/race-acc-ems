@model Employee

@{
    ViewData["Title"] = "Delete employee";
}

<h1>Delete employee</h1>
<p class="lede">This cannot be undone.</p>

<dl>
    <div>
        <dt>Name</dt>
        <dd>@Model.Name</dd>
    </div>
    <div>
        <dt>Designation</dt>
        <dd>@Model.Designation</dd>
    </div>
    <div>
        <dt>Age</dt>
        <dd>@Model.Age</dd>
    </div>
    <div>
        <dt>Salary</dt>
        <dd>@Model.Salary?.ToString("0.00")</dd>
    </div>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="actions">
        <button type="submit" class="danger">Delete</button>
        <a class="btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>
